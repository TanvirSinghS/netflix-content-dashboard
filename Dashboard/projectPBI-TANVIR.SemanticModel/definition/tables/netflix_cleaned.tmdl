	column 'Month Name' = IF ( ISBLANK ( netflix_cleaned[month_added] ), BLANK (), FORMAT ( DATE ( 2000, netflix_cleaned[month_added], 1 ), "MMM" ) )
		dataType: string
		lineageTag: 2f8a1c6d-1b2e-4f7a-9c3d-6e5b8a0d4c01
		sortByColumn: month_added
		summarizeBy: none

	column 'Runtime Band' = SWITCH ( TRUE (), netflix_cleaned[type] <> "Movie", BLANK (), ISBLANK ( netflix_cleaned[movie_minutes] ), "Unknown", netflix_cleaned[movie_minutes] < 60, "00-59", netflix_cleaned[movie_minutes] <= 90, "60-90", netflix_cleaned[movie_minutes] <= 120, "90-120", "120+" )
		dataType: string
		lineageTag: 2f8a1c6d-1b2e-4f7a-9c3d-6e5b8a0d4c02
		summarizeBy: none

	measure 'Movie %' = DIVIDE ( CALCULATE ( COUNTROWS ( netflix_cleaned ), netflix_cleaned[type] = "Movie" ), COUNTROWS ( netflix_cleaned ) )
		formatString: 0.0%
		lineageTag: 2f8a1c6d-1b2e-4f7a-9c3d-6e5b8a0d4c11

	measure 'Avg Movie Runtime' = AVERAGE ( netflix_cleaned[movie_minutes] )
		formatString: 0.0
		lineageTag: 2f8a1c6d-1b2e-4f7a-9c3d-6e5b8a0d4c12

	partition netflix_cleaned = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\artic\downloads\projbi\NetflixPBI\Data\netflix_cleaned.csv"),[Delimiter=",", Columns=21, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Replaced = Table.ReplaceValue(Promoted,"",null,Replacer.ReplaceValue,{"date_added", "year_added", "month_added", "movie_minutes", "tv_seasons", "release_year", "rating"}),
				    Typed = Table.TransformColumnTypes(Replaced,{{"show_id", type text}, {"type", type text}, {"title", type text}, {"director_raw", type text}, {"cast_raw", type text}, {"countries_raw", type text}, {"date_added", type date}, {"release_year", Int64.Type}, {"rating", type text}, {"duration", type text}, {"genres_raw", type text}, {"description", type text}, {"year_added", Int64.Type}, {"month_added", Int64.Type}, {"years_to_netflix", Int64.Type}, {"decade", type text}, {"movie_minutes", Int64.Type}, {"tv_seasons", Int64.Type}, {"audience", type text}, {"primary_country", type text}, {"primary_genre", type text}}),
				    Filtered = Table.SelectRows(Typed, each ([type] = "Movie" or [type] = "TV Show"))
				in
				    Filtered

	annotation PBI_ResultType = Table

