              },
              {
                "textRuns": [
                  {
                    "value": "Data: three cleaned CSVs (8,807 titles, 19,323 genre rows, 10,843 country rows) prepared in Python/pandas, loaded with Power Query in Import mode. No CSV was modified.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontFamily": "Segoe UI",
                      "color": "#B3B3B3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Model: one-to-many, single-direction relationships from netflix_cleaned[show_id] to netflix_genres[show_id] and netflix_countries[show_id].",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontFamily": "Segoe UI",
                      "color": "#B3B3B3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Measures: Movie % = DIVIDE(movie rows, all rows); Avg Movie Runtime = AVERAGE(movie_minutes). Every other number is Count of show_id.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontFamily": "Segoe UI",
                      "color": "#B3B3B3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Caveats: Unknown means missing - director 2,634, cast 825, country 833. Genre and country visuals count title tags, not unique titles, so they never sum to 8,807.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "fontFamily": "Segoe UI",
                      "color": "#B3B3B3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "10 titles have no date_added and drop out of time visuals; 7 have no rating. 2021 stops on 25 Sep 2021.",
                    "textStyle": {
                      "fontSize": "9pt",
